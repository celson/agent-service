# Obrigatória — única chave de API necessária
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo de chat (padrão: anthropic/claude-sonnet-4-6)
AGENT_MODEL=anthropic/claude-sonnet-4-6

# Modelo de embeddings via OpenRouter (padrão: openai/text-embedding-3-small)
EMBED_MODEL=openai/text-embedding-3-small

# Opcional — ativa MCP GitHub
GITHUB_TOKEN=ghp_...

# Opcional — ativa MCP Grafana (requer uvx instalado: pip install uv)
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_...

# Infraestrutura (docker-compose já configura)
DATABASE_URL=postgres://agent:secret@localhost:5432/agentdb?sslmode=disable
REDIS_ADDR=localhost:6379
FILES_BASE_DIR=./files
PORT=8080
