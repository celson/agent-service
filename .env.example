# AWS Bedrock — autenticação via default credentials chain do AWS SDK.
# Em ordem: env vars (abaixo) → ~/.aws/config (SSO) → ~/.aws/credentials → IMDS/IRSA.
# Modo recomendado em dev: `aws sso login` antes de subir o serviço.
AWS_REGION=us-east-1
AWS_PROFILE=default

# Override opcional dos modelos (defaults estão no código)
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Credenciais estáticas — só para CI ou ambientes sem SSO/IAM role.
# Deixe vazio para usar SSO/profile do AWS CLI.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Opcional — ativa MCP GitHub
GITHUB_TOKEN=

# Opcional — ativa MCP Grafana (requer uvx instalado: pip install uv)
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Infraestrutura (docker-compose já configura)
DATABASE_URL=postgres://agent:secret@localhost:5432/agentdb?sslmode=disable
REDIS_ADDR=localhost:6379
FILES_BASE_DIR=./files
PORT=8080
